# Postgres: postgresql+psycopg://usuario:senha@localhost:5432/manejoclima
# Sem DATABASE_URL o app usa sqlite local (só para desenvolvimento).
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/manejoclima
SECRET_KEY=troque-por-uma-string-longa-e-aleatoria
COOKIE_SECURE=1  # em produção (HTTPS)
